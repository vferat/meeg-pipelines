freesurfer_labelling_workflowoutputnode [label="{IN|<inatlasname> atlas_name|<inlhaseg> lh_aseg|<inrhaseg> rh_aseg|<insubjectid> subject_id|<insubjectsdir> subjects_dir|<involume> volume}|{ outputnode | utility |  }|{OUT}"];
freesurfer_labelling_workflowaparc2aseg:outoutfile:e -> freesurfer_labelling_workflowoutputnode:involume:w;
