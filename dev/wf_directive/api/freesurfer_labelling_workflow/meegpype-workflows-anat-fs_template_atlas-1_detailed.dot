digraph structs {
node [shape=record];
freesurfer_labelling_workflowinputnode [label="{IN}|{ inputnode | utility |  }|{OUT|<outatlasname> atlas_name|<outclassifierdatadir> classifier_data_dir|<outsubjectid> subject_id|<outsubjectsdir> subjects_dir}"];
