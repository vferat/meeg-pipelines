wb_labellinginputnode:outatlas:e -> wb_labellinggenerate_filenames_rh:inatlas:w;
wb_labellinginputnode:outsubject:e -> wb_labellingaparc2aseg:insubject:w;
wb_labellinginputnode:outsubject:e -> wb_labellinggenerate_annot_filename_lh:insubject:w;
wb_labellinginputnode:outsubject:e -> wb_labellinggenerate_annot_filename_rh:insubject:w;
wb_labellinginputnode:outsubject:e -> wb_labellinggenerate_dseg_filename:insubject:w;
