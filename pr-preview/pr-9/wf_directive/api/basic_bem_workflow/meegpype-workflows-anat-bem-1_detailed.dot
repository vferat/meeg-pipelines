digraph structs {
node [shape=record];
basic_bem_workflowinputnode [label="{IN}|{ inputnode | utility |  }|{OUT|<outsubjectid> subject_id|<outsubjectsdir> subjects_dir}"];
basic_bem_workflowwatershed [label="{IN|<insubject> subject|<insubjectsdir> subjects_dir}|{ watershed | mne |  }|{OUT|<outsubject> subject|<outsubjectsdir> subjects_dir|<outwatershedbrainsurf> watershed_brain_surf|<outwatershedinnerskull> watershed_inner_skull|<outwatershedouterskin> watershed_outer_skin|<outwatershedouterskull> watershed_outer_skull}"];
basic_bem_workflowinstall_surfaces [label="{IN|<inbrain> brain|<ininnerskull> inner_skull|<inouterskin> outer_skin|<inouterskull> outer_skull|<insubject> subject|<insubjectsdir> subjects_dir}|{ install_surfaces | utility |  }|{OUT|<outbrainsurf> brain_surf|<outinnerskullsurf> inner_skull_surf|<outouterskinsurf> outer_skin_surf|<outouterskullsurf> outer_skull_surf|<outsubject> subject|<outsubjectsdir> subjects_dir}"];
basic_bem_workflowoutputnode [label="{IN|<inbrainsurf> brain_surf|<ininnerskullsurf> inner_skull_surf|<inouterskinsurf> outer_skin_surf|<inouterskullsurf> outer_skull_surf|<insubjectid> subject_id|<insubjectsdir> subjects_dir}|{ outputnode | utility |  }|{OUT}"];
basic_bem_workflowinputnode:outsubjectid:e -> basic_bem_workflowwatershed:insubject:w;
basic_bem_workflowinputnode:outsubjectsdir:e -> basic_bem_workflowwatershed:insubjectsdir:w;
basic_bem_workflowinstall_surfaces:outbrainsurf:e -> basic_bem_workflowoutputnode:inbrainsurf:w;
basic_bem_workflowinstall_surfaces:outinnerskullsurf:e -> basic_bem_workflowoutputnode:ininnerskullsurf:w;
basic_bem_workflowinstall_surfaces:outouterskinsurf:e -> basic_bem_workflowoutputnode:inouterskinsurf:w;
basic_bem_workflowinstall_surfaces:outouterskullsurf:e -> basic_bem_workflowoutputnode:inouterskullsurf:w;
basic_bem_workflowinstall_surfaces:outsubject:e -> basic_bem_workflowoutputnode:insubjectid:w;
basic_bem_workflowinstall_surfaces:outsubjectsdir:e -> basic_bem_workflowoutputnode:insubjectsdir:w;
basic_bem_workflowwatershed:outsubject:e -> basic_bem_workflowinstall_surfaces:insubject:w;
basic_bem_workflowwatershed:outsubjectsdir:e -> basic_bem_workflowinstall_surfaces:insubjectsdir:w;
basic_bem_workflowwatershed:outwatershedbrainsurf:e -> basic_bem_workflowinstall_surfaces:inbrain:w;
basic_bem_workflowwatershed:outwatershedinnerskull:e -> basic_bem_workflowinstall_surfaces:ininnerskull:w;
basic_bem_workflowwatershed:outwatershedouterskin:e -> basic_bem_workflowinstall_surfaces:inouterskin:w;
basic_bem_workflowwatershed:outwatershedouterskull:e -> basic_bem_workflowinstall_surfaces:inouterskull:w;
}