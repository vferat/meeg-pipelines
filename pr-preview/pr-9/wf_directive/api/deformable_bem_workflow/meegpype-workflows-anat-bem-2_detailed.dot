digraph structs {
node [shape=record];
deformable_bem_workflowinputnode [label="{IN}|{ inputnode | utility |  }|{OUT|<outsubjectid> subject_id|<outsubjectsdir> subjects_dir}"];
deformable_bem_workflowfs_source [label="{IN|<insubjectid> subject_id|<insubjectsdir> subjects_dir}|{ fs_source | io |  }|{OUT|<outT1> T1|<outaseg> aseg|<outbrain> brain}"];
deformable_bem_workflowgenerate_bem_path [label="{IN|<insubjectid> subject_id|<insubjectsdir> subjects_dir}|{ generate_bem_path | utility |  }|{OUT|<outsubjectdir> subject_dir}"];
deformable_bem_workflowwatershed [label="{IN|<insubject> subject|<insubjectsdir> subjects_dir}|{ watershed | mne |  }|{OUT|<outsubject> subject|<outsubjectsdir> subjects_dir|<outwatershedouterskin> watershed_outer_skin|<outwatershedouterskull> watershed_outer_skull}"];
deformable_bem_workflowconvert_aseg [label="{IN|<ininfile> in_file}|{ convert_aseg | freesurfer |  }|{OUT|<outoutfile> out_file}"];
deformable_bem_workflowconvert_t1 [label="{IN|<ininfile> in_file}|{ convert_t1 | freesurfer |  }|{OUT|<outoutfile> out_file}"];
deformable_bem_workflowconvert_brain [label="{IN|<ininfile> in_file}|{ convert_brain | freesurfer |  }|{OUT|<outoutfile> out_file}"];
deformable_bem_workflowrefine_brain_mask [label="{IN|<ininanat> in_anat|<ininants> in_ants|<ininaseg> in_aseg}|{ refine_brain_mask | freesurfer |  }|{OUT|<outoutfile> out_file}"];
deformable_bem_workflowdatasink_brain_vol [label="{IN|<inbasedirectory> base_directory|<inbembrainvol> bem.@brain_vol}|{ datasink_brain_vol | io |  }|{OUT}"];
deformable_bem_workflowfit_brain [label="{IN|<ininmask> in_mask|<ininreference> in_reference}|{ fit_brain | custom |  }|{OUT|<outoutputsurface> output_surface}"];
deformable_bem_workflowfit_inner_skull [label="{IN|<ininmask> in_mask|<ininreference> in_reference}|{ fit_inner_skull | custom |  }|{OUT|<outoutputsurface> output_surface}"];
deformable_bem_workflowinstall_surfaces [label="{IN|<inbrain> brain|<ininnerskull> inner_skull|<inouterskin> outer_skin|<inouterskull> outer_skull|<insubject> subject|<insubjectsdir> subjects_dir}|{ install_surfaces | utility |  }|{OUT|<outbrainsurf> brain_surf|<outinnerskullsurf> inner_skull_surf|<outouterskinsurf> outer_skin_surf|<outouterskullsurf> outer_skull_surf|<outsubject> subject|<outsubjectsdir> subjects_dir}"];
deformable_bem_workflowoutputnode [label="{IN|<inbrainsurf> brain_surf|<ininnerskullsurf> inner_skull_surf|<inouterskinsurf> outer_skin_surf|<inouterskullsurf> outer_skull_surf|<insubjectid> subject_id|<insubjectsdir> subjects_dir}|{ outputnode | utility |  }|{OUT}"];
deformable_bem_workflowconvert_aseg:outoutfile:e -> deformable_bem_workflowrefine_brain_mask:ininaseg:w;
deformable_bem_workflowconvert_brain:outoutfile:e -> deformable_bem_workflowrefine_brain_mask:ininants:w;
deformable_bem_workflowconvert_t1:outoutfile:e -> deformable_bem_workflowrefine_brain_mask:ininanat:w;
deformable_bem_workflowfit_brain:outoutputsurface:e -> deformable_bem_workflowinstall_surfaces:inbrain:w;
deformable_bem_workflowfit_inner_skull:outoutputsurface:e -> deformable_bem_workflowinstall_surfaces:ininnerskull:w;
deformable_bem_workflowfs_source:outT1:e -> deformable_bem_workflowconvert_t1:ininfile:w;
deformable_bem_workflowfs_source:outT1:e -> deformable_bem_workflowfit_brain:ininreference:w;
deformable_bem_workflowfs_source:outT1:e -> deformable_bem_workflowfit_inner_skull:ininreference:w;
deformable_bem_workflowfs_source:outaseg:e -> deformable_bem_workflowconvert_aseg:ininfile:w;
deformable_bem_workflowfs_source:outbrain:e -> deformable_bem_workflowconvert_brain:ininfile:w;
deformable_bem_workflowgenerate_bem_path:outsubjectdir:e -> deformable_bem_workflowdatasink_brain_vol:inbasedirectory:w;
deformable_bem_workflowinputnode:outsubjectid:e -> deformable_bem_workflowfs_source:insubjectid:w;
deformable_bem_workflowinputnode:outsubjectid:e -> deformable_bem_workflowgenerate_bem_path:insubjectid:w;
deformable_bem_workflowinputnode:outsubjectid:e -> deformable_bem_workflowwatershed:insubject:w;
deformable_bem_workflowinputnode:outsubjectsdir:e -> deformable_bem_workflowfs_source:insubjectsdir:w;
deformable_bem_workflowinputnode:outsubjectsdir:e -> deformable_bem_workflowgenerate_bem_path:insubjectsdir:w;
deformable_bem_workflowinputnode:outsubjectsdir:e -> deformable_bem_workflowwatershed:insubjectsdir:w;
deformable_bem_workflowinstall_surfaces:outbrainsurf:e -> deformable_bem_workflowoutputnode:inbrainsurf:w;
deformable_bem_workflowinstall_surfaces:outinnerskullsurf:e -> deformable_bem_workflowoutputnode:ininnerskullsurf:w;
deformable_bem_workflowinstall_surfaces:outouterskinsurf:e -> deformable_bem_workflowoutputnode:inouterskinsurf:w;
deformable_bem_workflowinstall_surfaces:outouterskullsurf:e -> deformable_bem_workflowoutputnode:inouterskullsurf:w;
deformable_bem_workflowinstall_surfaces:outsubject:e -> deformable_bem_workflowoutputnode:insubjectid:w;
deformable_bem_workflowinstall_surfaces:outsubjectsdir:e -> deformable_bem_workflowoutputnode:insubjectsdir:w;
deformable_bem_workflowrefine_brain_mask:outoutfile:e -> deformable_bem_workflowdatasink_brain_vol:inbembrainvol:w;
deformable_bem_workflowrefine_brain_mask:outoutfile:e -> deformable_bem_workflowfit_brain:ininmask:w;
deformable_bem_workflowrefine_brain_mask:outoutfile:e -> deformable_bem_workflowfit_inner_skull:ininmask:w;
deformable_bem_workflowwatershed:outsubject:e -> deformable_bem_workflowinstall_surfaces:insubject:w;
deformable_bem_workflowwatershed:outsubjectsdir:e -> deformable_bem_workflowinstall_surfaces:insubjectsdir:w;
deformable_bem_workflowwatershed:outwatershedouterskin:e -> deformable_bem_workflowinstall_surfaces:inouterskin:w;
deformable_bem_workflowwatershed:outwatershedouterskull:e -> deformable_bem_workflowinstall_surfaces:inouterskull:w;
}