digraph structs {
node [shape=record];
fiducialsinputnode [label="{IN}|{ inputnode | utility |  }|{OUT|<outfiducials> fiducials|<outreference> reference|<outsubjectid> subject_id|<outsubjectsdir> subjects_dir}"];
fiducialsfs_source [label="{IN|<insubjectid> subject_id|<insubjectsdir> subjects_dir}|{ fs_source | io |  }|{OUT|<outT1> T1}"];
